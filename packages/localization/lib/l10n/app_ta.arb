  "adviceEmergencyUnresponsive": "இது ஒரு மருத்துவ அவசர நிலை. உடனே 108 ஐ அழைக்கவும். வாய் வழியாக எதையும் கொடுக்க வேண்டாம். நோயாளியை ஒரு பக்கமாகத் திருப்பிப் படுக்க வைத்து அவருடன் இருங்கள்.",
  "adviceEmergencyBleeding": "சுத்தமான துணியால் காயத்தை அழுத்திப் பிடித்துக்கொள்ளுங்கள். உடனே 108 ஐ அழைக்கவும்.",
  "adviceEmergencyPoisoning": "உடனே 108 ஐ அழைக்கவும். வாந்தி எடுக்க வைக்க முயற்சிக்க வேண்டாம். விஷப் பாட்டில் அல்லது அதன் லேபிளை எடுத்துச் செல்லுங்கள்.",
  "adviceEmergencySnakebite": "உடனே 108 ஐ அழைக்கவும். கடிபட்ட உறுப்பை அசைக்காமல் இதயத்திற்குக் கீழே வைத்திருங்கள். காயத்தை வெட்டவோ, உறிஞ்சவோ, கட்டவோ வேண்டாம். பாம்பு விஷ முறிவு மருந்து அவசரமாகத் தேவை.",
  "adviceEmergencyStroke": "உடனே 108 ஐ அழைக்கவும். அறிகுறிகள் தொடங்கிய நேரத்தைக் குறித்து வைத்திருங்கள் — சிகிச்சை அதைப் பொறுத்தது. உணவு அல்லது தண்ணீர் கொடுக்க வேண்டாம்.",
  "adviceEmergencyChestPain": "உடனே 108 ஐ அழைக்கவும். உட்கார்ந்து ஓய்வெடுங்கள்; நடக்கவோ நீங்களே வாகனம் ஓட்டவோ வேண்டாம். உடனடியாக இ.சி.ஜி தேவை.",
  "adviceEmergencyBreathlessness": "உடனே 108 ஐ அழைக்கவும். நேராக உட்கார்ந்து இறுக்கமான உடைகளைத் தளர்த்துங்கள். ஆக்சிஜன் தேவைப்படலாம்.",
  "adviceEmergencyObstetricBleeding": "உடனே 108 ஐ அழைக்கவும். இடது பக்கமாகப் படுத்துக்கொள்ளுங்கள். கர்ப்ப காலத்தில் இரத்தப்போக்கு அவசர சிகிச்சை தேவை.",
  "adviceEmergencyLabour": "பிரசவ வசதி உள்ள மருத்துவமனைக்கு இப்போதே செல்லுங்கள். வாகனம் தேவைப்பட்டால் 108 ஐ அழைக்கவும்.",
  "adviceEmergencyFetalMovement": "மகப்பேறு சிகிச்சை உள்ள மருத்துவமனைக்கு இப்போதே செல்லுங்கள். கருவின் அசைவு குறைவது உடனடியாகப் பரிசோதிக்கப்பட வேண்டும்.",
  "adviceEmergencySickChild": "குழந்தை நல சிகிச்சை உள்ள மருத்துவமனைக்கு உடனே அழைத்துச் செல்லுங்கள். வாகனத்திற்கு 108 ஐ அழைக்கவும். குழந்தையை சூடாக வைத்து, விழுங்க முடிந்தால் திரவம் கொடுத்துக்கொண்டே இருங்கள்.",
  "adviceEmergencyTrauma": "உடனே 108 ஐ அழைக்கவும். ஆபத்து இல்லாத வரை காயமடைந்தவரை அசைக்க வேண்டாம்.",
  "adviceEmergencyBurn": "தீக்காயத்தை 20 நிமிடங்கள் சுத்தமான ஓடும் தண்ணீரில் குளிர்விக்கவும். எண்ணெய், பற்பசை அல்லது பனிக்கட்டி வைக்க வேண்டாம். 108 ஐ அழைக்கவும்.",
  "adviceEmergencyAnuria": "உடனே 108 ஐ அழைக்கவும். சிறுநீர் கழிக்காமல் இருப்பது சிறுநீரகம் செயலிழப்பதைக் குறிக்கலாம்.",

  "adviceHighAnimalBite": "காயத்தை சோப்பு போட்டு ஓடும் தண்ணீரில் 15 நிமிடங்கள் கழுவி, இன்றே மருத்துவமனைக்குச் செல்லுங்கள். ரேபிஸ் தடுப்பூசி தேவை.",
  "adviceHighHaemoptysis": "இன்றே மருத்துவரைப் பாருங்கள். காசநோய் இல்லை என்பதை உறுதிப்படுத்த நெஞ்சு எக்ஸ்-ரே மற்றும் சளி பரிசோதனை தேவை.",
  "adviceHighTbSuspect": "இவ்வளவு நாட்கள் இருமல், எடை குறைவு அல்லது இரவில் வியர்வையுடன் இருந்தால் இன்றே காசநோய் பரிசோதனை தேவை. சிகிச்சை இலவசம்.",
  "adviceHighJaundice": "இன்றே மருத்துவரைப் பாருங்கள். கண் அல்லது தோல் மஞ்சளாக இருப்பதற்கான காரணம் அறிய இரத்தப் பரிசோதனை தேவை.",
  "adviceHighBreathlessness": "இன்றே மருத்துவரைப் பாருங்கள். மூச்சு மேலும் சிரமமானால் உடனே திரும்பி வரவும் அல்லது 108 ஐ அழைக்கவும்.",
  "adviceHighChestPainYoung": "இன்றே மருத்துவரைப் பார்த்து இ.சி.ஜி கேளுங்கள். வலி அதிகரித்தால், கை அல்லது தாடைக்குப் பரவினால், அல்லது வியர்வை வந்தால் 108 ஐ அழைக்கவும்.",
  "adviceHighPersistentFever": "இவ்வளவு நாட்கள் இந்த அளவு காய்ச்சல் இருந்தால், டெங்கு, மலேரியா அல்லது டைபாய்டு பரிசோதனை இன்றே தேவை.",
  "adviceHighPregnancy": "கர்ப்ப காலத்தில் ஏதேனும் புதிய அறிகுறி இருந்தால் அதே நாளில் மகப்பேறு சிகிச்சை உள்ள மருத்துவமனையில் பரிசோதிக்க வேண்டும்.",
  "adviceHighDiabetesFever": "சர்க்கரை நோய் இருந்தால் தொற்று விரைவில் மோசமாகும். இன்றே மருத்துவரைப் பாருங்கள்.",
  "adviceHighCardiacHistory": "உங்கள் இதய நோய் வரலாற்றைக் கருதி, இந்த அறிகுறிகளுக்கு இன்றே இ.சி.ஜி தேவை.",

  "adviceMediumDehydration": "ஒவ்வொரு முறை வயிற்றுப்போக்கிற்குப் பிறகும் ஓ.ஆர்.எஸ் குடிக்கவும். இன்றே மருத்துவமனைக்குச் செல்லுங்கள். திரவம் உள்ளே தங்காவிட்டால் அல்லது சிறுநீர் மிகக் குறைவாக இருந்தால் உடனே செல்லுங்கள்.",
  "adviceMediumAbdominalPain": "இன்றே மருத்துவரைப் பாருங்கள். வெறும் வயிற்றில் வலி நிவாரண மாத்திரை எடுக்க வேண்டாம். வலி கடுமையானால் அல்லது வயிறு இறுகினால் உடனே செல்லுங்கள்.",
  "adviceMediumFebrileIllness": "இன்றே மருத்துவரைப் பார்த்து, தேவைப்பட்டால் இரத்தப் பரிசோதனை செய்யுங்கள். நிறைய திரவம் குடித்து ஓய்வெடுங்கள்.",
  "adviceMediumUti": "இன்றே மருத்துவரைப் பாருங்கள். சிறுநீர் பரிசோதனை தேவை. அதுவரை நிறைய தண்ணீர் குடியுங்கள்.",
  "adviceMediumJointPain": "மருத்துவரைப் பார்த்து பரிசோதிக்கவும். மூட்டுக்கு ஓய்வு கொடுத்து கனமான பொருட்களைத் தூக்க வேண்டாம்.",
  "adviceMediumMentalHealth": "ஆலோசகர் அல்லது மருத்துவரிடம் பேசுவது உதவும். ஆன்லைன் ஆலோசனை மூலம் இதைச் செய்யலாம்; இது ரகசியமாக வைக்கப்படும்.",
  "adviceMediumVision": "கண் பரிசோதனை செய்யுங்கள். பார்வை திடீரென இழந்தால் அல்லது கண் வலி இருந்தால் உடனே செல்லுங்கள்.",
  "adviceMediumMinorBurn": "20 நிமிடங்கள் ஓடும் தண்ணீரில் குளிர்விக்கவும், சுத்தமான துணியால் தளர்வாக மூடவும், மருத்துவமனையில் கட்டுப் போடவும்.",
  "adviceMediumMinorInjury": "காயத்தைச் சுத்தம் செய்து பரிசோதிக்கவும். வீக்கம் இருந்தால் அல்லது அசைக்க முடியாவிட்டால் எக்ஸ்-ரே தேவைப்படலாம்.",
  "adviceMediumDental": "பல் மருத்துவர் அல்லது மருத்துவமனை மருத்துவரைப் பாருங்கள். வெதுவெதுப்பான உப்பு நீரில் வாய் கொப்பளிக்கவும், மிகச் சூடான அல்லது குளிர்ந்த உணவைத் தவிர்க்கவும்.",

  "adviceLowMildFever": "ஓய்வெடுங்கள், நிறைய திரவம் குடியுங்கள், பாராசிட்டமால் அறிவுரைப்படி எடுத்துக்கொள்ளுங்கள். காய்ச்சல் மூன்று நாட்களுக்கு மேல் நீடித்தால், 39C க்கு மேல் சென்றால், அல்லது மூச்சுத் திணறல், தோல் அரிப்பு அல்லது வாந்தி வந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceLowMildCough": "வெதுவெதுப்பான திரவங்கள் மற்றும் ஆவி பிடிப்பது உதவும். இருமல் இரண்டு வாரங்களுக்கு மேல் நீடித்தால், அல்லது காய்ச்சல், சளியில் இரத்தம் அல்லது மூச்சுத் திணறல் வந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceLowMildHeadache": "அமைதியான இருண்ட அறையில் ஓய்வெடுங்கள், தண்ணீர் குடியுங்கள், நேரத்திற்குச் சாப்பிடுங்கள். தலைவலி திடீரென மிகக் கடுமையாக இருந்தால், அல்லது காய்ச்சல், வாந்தி, பலவீனம் அல்லது பார்வை மாற்றத்துடன் வந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceLowSoreThroat": "வெதுவெதுப்பான உப்பு நீரில் வாய் கொப்பளிப்பதும் சூடான திரவங்களும் உதவும். விழுங்க அல்லது மூச்சு விட சிரமமாக இருந்தால், அல்லது காய்ச்சல் மூன்று நாட்களுக்கு மேல் இருந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceLowBackPain": "மெதுவாக நடமாடுங்கள், படுக்கையில் முழுநேர ஓய்வையும் கனமான வேலையையும் தவிர்க்கவும். வலி காலுக்குப் பரவினால், அல்லது மரத்துப்போதல், பலவீனம் அல்லது சிறுநீர் கழிப்பதில் சிரமம் இருந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceLowRash": "தோலைச் சுத்தமாகவும் காயவும் வைத்துக்கொள்ளுங்கள், சொறிய வேண்டாம். அரிப்பு வேகமாகப் பரவினால், கொப்புளம் வந்தால், அல்லது காய்ச்சல் அல்லது மூச்சுத் திணறலுடன் இருந்தால் மருத்துவரைப் பாருங்கள்.",
  "adviceDefaultVisitFacility": "உங்கள் அறிகுறிகளை சரியாக மதிப்பிடுவதற்கு மருத்துவரைப் பாருங்கள்.",
  "adviceWhenToReturn": "உடல்நிலை மோசமானால் உடனே திரும்பி வரவும் அல்லது 108 ஐ அழைக்கவும்.",

  "followupDefault": "நோயாளியின் நிலையைப் பரிசோதித்து விளைவைப் பதிவு செய்யுங்கள்.",
  "followupPostReferral": "நோயாளி மருத்துவமனைக்குச் சென்றாரா, பரிசோதிக்கப்பட்டாரா என்பதை உறுதிப்படுத்தி என்ன நடந்தது என்று பதிவு செய்யுங்கள்.",

  "errorUnauthenticated": "தொடர உள்நுழையவும்.",
