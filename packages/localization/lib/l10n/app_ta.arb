  "errorNotPermitted": "இதைச் செய்ய உங்களுக்கு அனுமதி இல்லை.",
  "errorInvalidInput": "நீங்கள் உள்ளிட்டதைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.",
  "errorNotFound": "இந்தப் பதிவு கிடைக்கவில்லை.",
  "errorAlreadyExists": "இது ஏற்கனவே உள்ளது.",
  "errorRelatedRecordMissing": "இதற்குத் தேவையான ஒரு பதிவு இல்லை.",
  "errorOffline": "நீங்கள் இணையத்தில் இல்லை எனத் தெரிகிறது. உங்கள் தகவலைச் சேமித்து மீண்டும் முயற்சிக்கிறோம்.",
  "errorUnexpected": "ஏதோ தவறு நடந்தது. மீண்டும் முயற்சிக்கவும்.",
  "errorActionNotAllowed": "இந்தச் செயலுக்கு இப்போது அனுமதி இல்லை.",
  "errorReferralTransitionIllegal": "இந்தப் பரிந்துரை ஏற்கனவே அடுத்த நிலைக்குச் சென்றுவிட்டது. தற்போதைய நிலையைக் காண புதுப்பிக்கவும்.",
  "errorReasonRequired": "காரணத்தைக் குறிப்பிடவும்.",
  "errorOutcomeRequired": "விளைவைப் பதிவு செய்யவும்.",
  "errorOverrideReasonRequired": "கைமுறை மாற்றத்திற்கு காரணம் தேவை.",
  "errorFacilityNotOperational": "இந்த மருத்துவமனை தற்போது இயங்கவில்லை.",
  "errorTriageUnavailable": "அறிகுறி மதிப்பீடு இப்போது கிடைக்கவில்லை. உங்கள் ஆஷா பணியாளரைத் தொடர்பு கொள்ளவும், அவசரமானால் 108 ஐ அழைக்கவும்.",
  "errorProfileMissing": "உங்கள் கணக்கு இன்னும் அமைக்கப்படவில்லை. நிர்வாகியைத் தொடர்பு கொள்ளவும்.",
  "errorNoAudioCaptured": "எதுவும் கேட்கவில்லை. மீண்டும் முயற்சிக்கவும்.",
  "errorTtsUnavailable": "ஒலி வடிவ பதில் கிடைக்கவில்லை. உரை திரையில் காட்டப்படுகிறது.",
  "errorAmbulanceRequestFailed": "வாகனத்தைக் கோர முடியவில்லை. நேரடியாக 108 ஐ அழைக்கவும்.",
  "errorStorage": "அந்தக் கோப்பைப் பதிவேற்ற முடியவில்லை.",
  "errorPatientDistrictUnknown": "இந்த நோயாளிக்கு மாவட்டம் பதிவு செய்யப்படவில்லை; எனவே வாகனத்தைக் கோர முடியாது.",
  "errorLocationDenied": "அருகிலுள்ள மருத்துவமனைகளைக் கண்டுபிடிக்க உங்கள் இருப்பிடம் தேவை. அல்லது உங்கள் கிராமத்தைத் தேர்ந்தெடுக்கலாம்.",
  "errorLocationUnavailable": "உங்கள் இருப்பிடத்தைப் பெற முடியவில்லை. உங்கள் கிராமத்தைத் தேர்ந்தெடுக்கவும்."
