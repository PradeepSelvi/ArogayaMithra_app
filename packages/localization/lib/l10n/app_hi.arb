  "adviceEmergencyBreathlessness": "तुरंत 108 पर कॉल करें। सीधे बैठें और तंग कपड़े ढीले करें। ऑक्सीजन की आवश्यकता हो सकती है।",
  "adviceEmergencyObstetricBleeding": "तुरंत 108 पर कॉल करें। अपनी बाईं करवट लेट जाएं। गर्भावस्था में रक्तस्राव के लिए तत्काल देखभाल आवश्यक है।",
  "adviceEmergencyLabour": "अभी प्रसव सेवाओं वाले केंद्र जाएं। यदि आवश्यक हो तो परिवहन के लिए 108 पर कॉल करें।",
  "adviceEmergencyFetalMovement": "अभी प्रसूति देखभाल वाले केंद्र जाएं। शिशु की गतिविधि में कमी की तुरंत जांच होनी चाहिए।",
  "adviceEmergencySickChild": "बच्चे को तुरंत बाल चिकित्सा सुविधा वाले केंद्र ले जाएं। परिवहन के लिए 108 पर कॉल करें। बच्चे को गर्म रखें और यदि वह निगल सकता है तो तरल पदार्थ देते रहें।",
  "adviceEmergencyTrauma": "तुरंत 108 पर कॉल करें। घायल व्यक्ति को तब तक न हिलाएं जब तक वे खतरे में न हों।",
  "adviceEmergencyBurn": "जले हुए स्थान को 20 मिनट तक साफ़ बहते पानी के नीचे ठंडा करें। तेल, टूथपेस्ट या बर्फ़ न लगाएं। 108 पर कॉल करें।",
  "adviceEmergencyAnuria": "तुरंत 108 पर कॉल करें। लगभग बिल्कुल पेशाब न आना गुर्दे के फेल होने का संकेत हो सकता है।",

  "adviceHighAnimalBite": "घाव को साबुन और बहते पानी से 15 मिनट तक धोएं और आज ही केंद्र जाएं। आपको रेबीज़ का टीका चाहिए।",
  "adviceHighHaemoptysis": "आज ही डॉक्टर से मिलें। क्षय रोग (टीबी) को रद्द करने के लिए आपको छाती का एक्स-रे और थूक की जांच चाहिए।",
  "adviceHighTbSuspect": "इतने लंबे समय से खांसी के साथ वज़न कम होना या रात में पसीना आना, आज ही टीबी जांच की आवश्यकता है। उपचार निःशुल्क है।",
  "adviceHighJaundice": "आज ही डॉक्टर से मिलें। आँखों या त्वचा का पीला होना, कारण जानने के लिए रक्त जांच आवश्यक है।",
  "adviceHighBreathlessness": "आज ही डॉक्टर से मिलें। सांस लेने में और तकलीफ़ होने पर तुरंत वापस जाएं या 108 पर कॉल करें।",
  "adviceHighChestPainYoung": "आज ही डॉक्टर से मिलें और ईसीजी के लिए कहें। यदि दर्द बढ़े, बांह या जबड़े तक फैले, या पसीना आने लगे तो 108 पर कॉल करें।",
  "adviceHighPersistentFever": "इतने लंबे समय तक इतना तेज़ बुखार होने पर डेंगू, मलेरिया या टाइफ़ाइड की जांच के लिए आज ही रक्त जांच आवश्यक है।",
  "adviceHighPregnancy": "गर्भावस्था में किसी भी नए लक्षण की उसी दिन प्रसूति देखभाल वाले केंद्र में जांच होनी चाहिए।",
  "adviceHighDiabetesFever": "मधुमेह के साथ, संक्रमण जल्दी बिगड़ सकता है। आज ही डॉक्टर से मिलें।",
  "adviceHighCardiacHistory": "आपके हृदय के इतिहास के साथ, इन लक्षणों के लिए आज ही ईसीजी आवश्यक है।",

  "adviceMediumDehydration": "हर पतले दस्त के बाद ORS पिएं। आज ही केंद्र जाएं, और जल्दी जाएं यदि आप तरल पदार्थ नहीं रख पा रहे या बहुत कम पेशाब आ रहा है।",
  "adviceMediumAbdominalPain": "आज ही चिकित्सक से मिलें। खाली पेट दर्दनिवारक न लें। यदि दर्द गंभीर हो जाए या पेट सख्त महसूस हो तो तुरंत जाएं।",
  "adviceMediumFebrileIllness": "आज ही जांच और आवश्यकता पड़ने पर रक्त जांच के लिए चिकित्सक से मिलें। पर्याप्त तरल पदार्थ पिएं और आराम करें।",
  "adviceMediumUti": "आज ही चिकित्सक से मिलें। पेशाब की जांच आवश्यक है। इस बीच पर्याप्त पानी पिएं।",
  "adviceMediumJointPain": "आकलन के लिए चिकित्सक से मिलें। जोड़ को आराम दें और भारी सामान उठाने से बचें।",
  "adviceMediumMentalHealth": "किसी परामर्शदाता या डॉक्टर से बात करना मदद करता है। आप यह ऑनलाइन परामर्श से कर सकते हैं, और यह गोपनीय है।",
  "adviceMediumVision": "अपनी आँखों की जांच कराएं। यदि दृष्टि अचानक कम हो या आँख में दर्द हो तो जल्दी जाएं।",
  "adviceMediumMinorBurn": "20 मिनट तक बहते पानी के नीचे ठंडा करें, साफ़ कपड़े से ढीला ढकें, और केंद्र में इसकी ड्रेसिंग कराएं।",
  "adviceMediumMinorInjury": "चोट को साफ़ करवाकर जांच कराएं। यदि सूजन हो या आप इसे हिला न सकें तो एक्स-रे की आवश्यकता हो सकती है।",
  "adviceMediumDental": "दंत चिकित्सक या केंद्र के डॉक्टर से मिलें। गुनगुने नमक के पानी से कुल्ला करें और बहुत गर्म या ठंडा भोजन न लें।",

  "adviceLowMildFever": "आराम करें, पर्याप्त तरल पदार्थ पिएं और निर्देशानुसार पैरासिटामोल लें। यदि बुखार तीन दिन से अधिक रहे, 39C से ऊपर जाए, या सांस फूलना, चकत्ते या उल्टी हो तो चिकित्सक से मिलें।",
  "adviceLowMildCough": "गर्म तरल पदार्थ और भाप लेना मदद करता है। यदि खांसी दो सप्ताह से अधिक रहे, या बुखार, थूक में खून या सांस फूलना हो तो चिकित्सक से मिलें।",
  "adviceLowMildHeadache": "शांत, अंधेरे कमरे में आराम करें, पानी पिएं और नियमित भोजन करें। यदि सिरदर्द अचानक और गंभीर हो, या बुखार, उल्टी, कमज़ोरी या दृष्टि में बदलाव के साथ हो तो चिकित्सक से मिलें।",
  "adviceLowSoreThroat": "गुनगुने नमक के पानी से गरारे और गर्म तरल पदार्थ मदद करते हैं। यदि निगलने या सांस लेने में कठिनाई हो, या बुखार तीन दिन से अधिक रहे तो चिकित्सक से मिलें।",
  "adviceLowBackPain": "धीरे-धीरे चलते रहें, बिस्तर पर आराम और भारी सामान उठाने से बचें। यदि दर्द पैर तक फैले, या सुन्नपन, कमज़ोरी या पेशाब करने में परेशानी हो तो चिकित्सक से मिलें।",
  "adviceLowRash": "त्वचा को साफ़ और सूखा रखें और खुजलाने से बचें। यदि चकत्ते तेज़ी से फैलें, फफोले पड़ें, या बुखार या सांस फूलने के साथ हों तो चिकित्सक से मिलें।",
  "adviceDefaultVisitFacility": "कृपया चिकित्सक से मिलें ताकि आपके लक्षणों का सही आकलन हो सके।",
  "adviceWhenToReturn": "यदि हालत बिगड़े तो तुरंत वापस आएं या 108 पर कॉल करें।",

